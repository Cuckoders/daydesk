DAYDESK_SETUP_CODE=
DAYDESK_DB_PATH=./data/daydesk-sync.sqlite
DAYDESK_HOST=127.0.0.1
DAYDESK_PORT=4310
DAYDESK_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# Сгенерируйте: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
DAYDESK_MAIL_KEY=
# Включайте только если доверяете всем зарегистрированным устройствам и нужен корпоративный IMAP в LAN.
DAYDESK_ALLOW_PRIVATE_MAIL_HOSTS=false
# Публичный HTTPS origin сервера и OAuth credentials из Google Cloud / Microsoft Entra.
DAYDESK_OAUTH_PUBLIC_URL=
DAYDESK_GOOGLE_CLIENT_ID=
DAYDESK_GOOGLE_CLIENT_SECRET=
DAYDESK_MICROSOFT_CLIENT_ID=
DAYDESK_MICROSOFT_CLIENT_SECRET=
